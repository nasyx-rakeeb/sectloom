{
  "name": "sectloom",
  "version": "0.1.0",
  "description": "Sectloom CLI for installing React components",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sectloom": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --external:commander --external:@clack/prompts --external:picocolors --external:zod --external:diff",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.0",
    "zod": "^3.23.8",
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@sectloom/contracts": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/diff": "^5.2.1",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.5"
  }
}
